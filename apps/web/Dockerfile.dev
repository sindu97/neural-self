# Development image for the web app: Vite dev server with hot reload.
# The source is mounted from the host (see docker-compose.yml); dependencies
# live in the image / a named volume because they include Linux-only binaries.
FROM node:22-slim

WORKDIR /app

COPY package.json package-lock.json ./
# --ignore-scripts: the only install script that matters (fetching the voice
# model into public/) needs the mounted source, so the entrypoint runs it.
RUN npm ci --no-audit --no-fund --ignore-scripts \
    && sha256sum package-lock.json > node_modules/.package-lock.sha256

COPY docker-entrypoint.dev.sh /usr/local/bin/docker-entrypoint.dev.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.dev.sh

EXPOSE 5173
ENTRYPOINT ["docker-entrypoint.dev.sh"]
# Run Vite directly (not via npm) so it receives SIGTERM and stops cleanly.
CMD ["./node_modules/.bin/vite", "--host", "0.0.0.0", "--port", "5173", "--strictPort"]
