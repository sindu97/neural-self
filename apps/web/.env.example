# Copy to .env.local to override. All values are optional.

# API base. The default same-origin path works with the Vite dev proxy
# (vite.config.ts) and with a reverse proxy in production.
VITE_API_BASE_URL=/api/v1

# Where the dev proxy forwards /api (the FastAPI backend).
VITE_PROXY_TARGET=http://localhost:8000
