# Copy to backend/.env and adjust. Never commit the real .env.
APP_NAME=NeuralShelf
APP_ENV=development
DEBUG=false
API_V1_PREFIX=/api/v1

# Host port 5433 is the Docker db service (docker compose overrides this inside containers).
DATABASE_URL=postgresql://neuralshelf:neuralshelf_local_dev@localhost:5433/neuralshelf

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3.5:2b-q4_K_M
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

LOG_LEVEL=INFO
LOG_FORMAT=text

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 characters; required in production.
JWT_SECRET_KEY=change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Browser origins of the web app (comma-separated).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Optional tuning (defaults shown):
# MAX_UPLOAD_SIZE_MB=20
# RATE_LIMIT_LOGIN_PER_EMAIL=5
# JOB_LEASE_SECONDS=120
# JOB_MAX_ATTEMPTS=5
